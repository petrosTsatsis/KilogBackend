# Project Settings
PROJECT_NAME=Kilog
PROJECT_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kilog

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx
CLERK_FRONTEND_API=

# JWT Key (for local token verification fallback)
JWT_KEY=your-pem-key-here

# Supabase (if used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# CORS (comma-separated origins)
# For production, add your Vercel frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://kilog-app.vercel.app
